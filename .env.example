PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
DEVOPS_APPROVER_PASSWORD=devops123
DATA_FILE=./data/requests.json

# Keep dry-run until Azure DevOps and Kubernetes access are configured.
PROVISION_MODE=dry-run

# Azure DevOps live provisioning
AZDO_ORG=
AZDO_PROJECT=
AZDO_PAT=

# Kubernetes live provisioning. Leave blank to use the default kubeconfig.
KUBECONFIG=
